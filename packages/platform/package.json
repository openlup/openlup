{
  "name": "@openlup/platform",
  "version": "0.16.0",
  "private": false,
  "description": "Runnable server substrate: Node HTTP runtime, BFF dispatch, scheduler, storage, data gateways and bundle composition; development preview.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "sideEffects": false,
  "files": [
    "dist/**",
    "src/**",
    "sql/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "release-gates.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "vitest run test",
    "ci": "npm run build && npm run test && npm run api:check",
    "api:check": "node --experimental-strip-types ./scripts/api-contract.ts",
    "test:consumer": "node --experimental-strip-types ./scripts/consumer-proof.ts",
    "ci:required": "npm run test:consumer",
    "prepack": "npm run build",
    "prepublishOnly": "node -e \"throw new Error('PLATFORM_DIRECTORY_PUBLISH_REFUSED')\"",
    "api:update": "npm run build && node --experimental-strip-types ./scripts/api-contract.ts --update"
  },
  "peerDependencies": {
    "@openlup/core": "0.16.0",
    "pg": "^8.22.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@types/pg": "^8.20.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@types/pg": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "exports": {
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "default": "./dist/http/index.js"
    },
    "./bff": {
      "types": "./dist/bff/index.d.ts",
      "import": "./dist/bff/index.js",
      "default": "./dist/bff/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "import": "./dist/scheduler/index.js",
      "default": "./dist/scheduler/index.js"
    },
    "./blob": {
      "types": "./dist/blob/index.d.ts",
      "import": "./dist/blob/index.js",
      "default": "./dist/blob/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "import": "./dist/migrations/index.js",
      "default": "./dist/migrations/index.js"
    },
    "./job-ledger": {
      "types": "./dist/job-ledger/index.d.ts",
      "import": "./dist/job-ledger/index.js",
      "default": "./dist/job-ledger/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "default": "./dist/kernel/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "import": "./dist/composition/index.js",
      "default": "./dist/composition/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js",
      "default": "./dist/identity/index.js"
    },
    "./identity/contracts": {
      "types": "./dist/identity/contracts/index.d.ts",
      "import": "./dist/identity/contracts/index.js",
      "default": "./dist/identity/contracts/index.js"
    },
    "./communications": {
      "types": "./dist/communications/index.d.ts",
      "import": "./dist/communications/index.js",
      "default": "./dist/communications/index.js"
    },
    "./communications/contracts": {
      "types": "./dist/communications/contracts/index.d.ts",
      "import": "./dist/communications/contracts/index.js",
      "default": "./dist/communications/contracts/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js",
      "default": "./dist/catalog/index.js"
    },
    "./catalog/contracts": {
      "types": "./dist/catalog/contracts/index.d.ts",
      "import": "./dist/catalog/contracts/index.js",
      "default": "./dist/catalog/contracts/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "import": "./dist/pricing/index.js",
      "default": "./dist/pricing/index.js"
    },
    "./pricing/contracts": {
      "types": "./dist/pricing/contracts/index.d.ts",
      "import": "./dist/pricing/contracts/index.js",
      "default": "./dist/pricing/contracts/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openlup/openlup.git",
    "directory": "packages/platform"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "preview"
  }
}
