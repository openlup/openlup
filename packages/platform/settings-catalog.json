    {
      "key": "inventory_renewal_protection",
      "domain": "inventory",
      "kind": "installed",
      "goal": "Set the renewal stock protection horizon used to calculate stock available to new purchases.",
      "schemaVersion": 1,
      "examples": [
        {
          "value": {
            "revision": "store-1",
            "renewalProtectionDays": 21
          }
        },
        {
          "value": {
            "revision": " ",
            "renewalProtectionDays": 21
          },
          "code": "inventory_renewal_protection_policy_invalid"
        },
        {
          "value": {
            "revision": "store-1",
            "renewalProtectionDays": 0
          },
          "code": "inventory_renewal_protection_policy_invalid"
        }
      ],
      "fallback": {
        "revision": "default",
        "renewalProtectionDays": 14
      },
      "defaultBasis": {
        "kind": "reference-code"
      },
      "whyThisDefault": "Two weeks cover a typical replenishment cycle and preserve the established stock priority.",
      "effect": {
        "appliesTo": "Future available-to-promise calculations and new purchase allocations.",
        "frozenOn": [
          "Existing reservations keep their quantities and expiry times."
        ],
        "impact": "operations"
      },
      "runtime": {
        "level": "preview",
        "reason": "Preview estimates availability for named SKUs. Apply changes with the installer at deployment."
      },
      "change": {
        "operation": "installRenewalStockProtectionPolicy"
      },
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "revision": {
            "type": "string"
          },
          "renewalProtectionDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3660
          }
        },
        "required": [
          "revision",
          "renewalProtectionDays"
        ],
        "additionalProperties": false
      },
      "previewSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "existingReservations": {
            "type": "string",
            "const": "unchanged"
          },
          "newPurchaseAvailability": {
            "type": "string",
            "enum": [
              "equal-or-lower",
              "equal-or-higher",
              "unchanged",
              "undetermined"
            ]
          },
          "skus": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "provider",
                    "missing"
                  ]
                },
                "stale": {
                  "type": "boolean"
                },
                "currentAvailableForNewPurchases": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "proposedAvailableForNewPurchases": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "sku",
                "source",
                "stale",
                "currentAvailableForNewPurchases",
                "proposedAvailableForNewPurchases"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "existingReservations",
          "newPurchaseAvailability",
          "skus"
        ],
        "additionalProperties": false
      },
      "rules": [
