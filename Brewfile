# openlup local dev prerequisites (macOS). Run: brew bundle
# Node 24 and Docker Desktop are NOT listed — install those yourself
# (nvm/`brew install node@24`, and Docker Desktop) per README.
brew "supabase/tap/supabase" # Supabase CLI (local Postgres/Auth/Storage + migrations)
brew "libpq"                 # psql client (DB readiness + seeding); keg-only
brew "jq"                    # JSON parsing of `supabase status -o json`
brew "actionlint"            # Local GitHub Actions parity for workflow-only diffs
