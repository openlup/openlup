{
  "name": "openlup",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#deployment-analytics": "./src/lib/analytics/noop.ts",
    "#application-domains": "./src/lib/exampleApplicationDomains.ts",
    "#email-presentation": "./src/domains/communications/email/exampleEmailPresentation.ts",
    "#email-registry-projection": "./src/domains/communications/exampleEmailRegistryProjection.ts",
    "#commerce-email-content": "./src/domains/commerce/emails/exampleCommerceEmailContent.ts",
    "#subscription-email-content": "./src/domains/subscription/emails/exampleSubscriptionEmailContent.ts",
    "#deployment-media": "./src/lib/media/exampleDeploymentMedia.ts",
    "#delivery-dispatch-policy": "./src/domains/subscription/exampleDispatchPolicy.ts",
    "#storefront-ssg-catalog": "./src/domains/catalog/exampleStorefrontSsgCatalog.ts",
    "#storefront-ssg-details": "./src/domains/catalog/exampleStorefrontSsgCatalog.ts",
    "#cancel-survey-reasons": "./src/domains/subscription/exampleCancelSurveyReasons.ts",
    "#storefront-can-art": "./src/domains/catalog/exampleStorefrontCanArt.ts",
    "#checkout-terminal-route": "./src/checkout/entry/checkoutTerminalRoute.ts",
    "#acquisition-case-routes": "./server/bff/clients/acquisitionCaseDirect.ts",
    "#tester-program-email-binding": "./server/runtime/communications/testerProgramEmailBinding.ts",
    "#auth-email-content": "./server/runtime/authEmailContentBinding.ts",
    "#deployment-route-policy": "./server/_lib/publicDeploymentPolicies.ts",
    "#accounting-provider-activation": "./server/_lib/publicDeploymentPolicies.ts",
    "#communications-egress-policy": "./server/_lib/publicDeploymentPolicies.ts"
  },
  "workspaces": [
    "packages/core",
    "packages/outbox",
    "packages/platform"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "npm run build:public-reference",
    "build:public-reference": "npm --workspace @openlup/core run build && npm --workspace @openlup/platform run build && npm run guard:client-secret-boundary && npm run guard:public-reference-site-routes && npm run build:public-reference:client && npm run build:public-reference:ssr && npm run build:public-reference:prerender",
    "build:public-reference:client": "OPENLUP_BUILD_TARGET=public-reference vite build --configLoader native",
    "build:public-reference:prerender": "node --experimental-strip-types scripts/oss-reference-prerender.ts",
    "build:public-reference:ssr": "OPENLUP_BUILD_TARGET=public-reference-ssr vite build --configLoader native",
    "check:dco-signoff": "node --experimental-strip-types scripts/dco-signoff-check.ts",
    "guard:client-secret-boundary": "node --experimental-strip-types scripts/check-client-secret-boundary.ts",
    "guard:public-reference-site-routes": "node scripts/site-routes.mjs --public-reference",
    "lint": "node scripts/ast-grep/check-filewide-ignore.mjs && ast-grep scan --error=no-suppress-all --error=unused-suppression && ast-grep test --skip-snapshot-tests && eslint .",
    "prelint": "npm --workspace @openlup/core run build && npm --workspace @openlup/outbox run build && npm --workspace @openlup/platform run build",
    "oss:published-tree": "node scripts/agent-context/generate.mjs --check && node --experimental-strip-types scripts/oss-published-tree-check.ts",
    "packages:check": "node --experimental-strip-types scripts/packages/packages-check.ts",
    "release:bump": "node --experimental-strip-types scripts/packages/release-bump.ts",
    "pretest": "npm --workspace @openlup/core run build && npm --workspace @openlup/outbox run build && npm --workspace @openlup/platform run build",
    "test": "node scripts/run-vitest.mjs run",
    "test:scoped": "scope_file=$(mktemp) && trap 'rm -f \"$scope_file\"' EXIT && export OPENLUP_VITEST_EXCLUDE_FILE=\"$scope_file\" && node scripts/ci-test-scope.mjs && npm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openlup/core": "file:packages/core",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^24.19.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.43.0",
    "i18next": "^26.5.11",
    "input-otp": "^1.5.0",
    "jose": "6.2.13",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.63.0",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "postcode-validator": "^3.10.26",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.15.1",
    "react-router-dom": "^7.18.5",
    "react-share": "^5.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "@openlup/outbox": "file:packages/outbox",
    "@openlup/platform": "file:packages/platform"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@aws-sdk/client-s3": "3.1159.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/formidable": "^3.5.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "beasties": "^0.5.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "onnxruntime-node"
  ],
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    },
    "rolldown": "1.1.4",
    "fast-uri": "^3.1.6",
    "qs": "^6.17.1"
  }
}
