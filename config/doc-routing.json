    {
      "id": "subscription-services",
      "when": "Available domain service entrypoints and their composition limitations",
      "paths": [
        "server/domains/subscription/checkoutActivationBridge.ts",
        "server/domains/subscription/runAutomaticSubscriptionRenewal.ts"
      ],
      "doc": "docs/platform/SUBSCRIPTION_WORKFLOWS.md",
      "anchor": "#available-domain-services"
