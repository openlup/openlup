{
  "version": 2,
  "surfaces": [
    {
      "id": "repository",
      "when": "Repository entrypoints, build configuration and contributor setup",
      "paths": [
        "*"
      ],
      "doc": "CONTRIBUTING.md",
      "anchor": "#development-preview-checks"
    },
    {
      "id": "public-policy",
      "when": "Public contribution policy and community governance",
      "paths": [
        ".github/**"
      ],
      "doc": "CONTRIBUTING.md",
      "anchor": "#pull-requests"
    },
    {
      "id": "public-checks",
      "when": "Hosted execution ownership and the checks contributors must run",
      "paths": [
        ".github/workflows/**"
      ],
      "doc": "CONTRIBUTING.md",
      "anchor": "#development-preview-checks"
    },
    {
      "id": "documentation",
      "when": "Public documentation navigation and current writing guidance",
      "paths": [
        "docs/**"
      ],
      "doc": "docs/platform/DOCUMENTATION.md",
      "anchor": "#authoring"
    },
    {
      "id": "history",
      "when": "Dated public implementation plans, with no runtime authority",
      "paths": [
        "docs/platform/plans/**"
      ],
      "doc": "docs/platform/DOCUMENTATION.md",
      "anchor": "#authoring"
    },
    {
      "id": "configuration",
      "when": "Machine-readable platform configuration and contract inputs",
      "paths": [
        "config/**"
      ],
      "doc": "docs/platform/CANONICAL_CONTRACTS.md",
      "anchor": "#compatibility-posture"
    },
    {
      "id": "ownership",
      "when": "Documentation ownership, publication inventory and generated projections",
      "paths": [
        "config/doc-routing.json",
        "config/openlup-publication-catalog.json",
        "config/openlup-source-release-contract.json",
        "scripts/documentation-routing.ts"
      ],
      "doc": "docs/platform/DOCUMENTATION.md",
      "anchor": "#ownership"
    },
    {
      "id": "browser",
      "when": "Browser components, routes, clients and application composition",
      "paths": [
        "src/**"
      ],
      "doc": "docs/platform/ARCHITECTURE_AND_EXTENSIONS.md",
      "anchor": "#runtime-boundaries"
    },
    {
      "id": "server",
      "when": "Server composition, shared server utilities and use cases",
      "paths": [
        "server/**"
      ],
      "doc": "docs/platform/ARCHITECTURE_AND_EXTENSIONS.md",
      "anchor": "#runtime-boundaries"
    },
    {
      "id": "adapters",
      "when": "Provider translation at domain ports and capability refusals",
      "paths": [
        "server/adapters/**"
      ],
      "doc": "server/adapters/README.md",
      "anchor": ""
    },
    {
      "id": "infrastructure",
      "when": "Low-level clients, environment parsing and server infrastructure",
      "paths": [
        "server/infra/**"
      ],
      "doc": "docs/platform/RUNTIME_AND_SELF_HOSTING.md",
      "anchor": "#provider-and-host-boundaries"
    },
    {
      "id": "bff",
      "when": "Server HTTP composition and public interface boundaries",
      "paths": [
        "server/bff/**",
        "api/**"
      ],
      "doc": "docs/platform/RUNTIME_AND_SELF_HOSTING.md",
      "anchor": "#runtime-model"
    },
    {
      "id": "reference",
      "when": "The bounded static and opt-in subscription evaluation profiles",
      "paths": [
        "server/runtime/public-reference/**",
        "src/public-reference/**",
        "vite.public-reference.config.ts",
        "scripts/oss-reference-*.ts"
      ],
      "doc": "docs/platform/RUNTIME_AND_SELF_HOSTING.md",
      "anchor": "#opt-in-disposable-subscription-reference"
    },
    {
      "id": "data",
      "when": "Durable data, ordered migration history and compatibility lifecycle",
      "paths": [
        "db/**",
        "supabase/**",
        "src/integrations/**"
      ],
      "doc": "docs/platform/DATA_AND_MIGRATIONS.md",
      "anchor": "#compatibility-lifecycle"
    },
    {
      "id": "packages",
      "when": "Package API, exports, release-shape and consumer boundaries",
      "paths": [
        "packages/**"
      ],
      "doc": "packages/core/README.md",
      "anchor": ""
    },
    {
      "id": "core",
      "when": "Portable neutral core kernels and their package verification",
      "paths": [
        "packages/core/**"
      ],
      "doc": "packages/core/README.md",
      "anchor": ""
    },
    {
      "id": "subscription-kernel",
      "when": "Pure lifecycle, retry, cycle and deterministic-clock behavior",
      "paths": [
        "packages/core/src/subscription/**"
      ],
      "doc": "packages/core/docs/SUBSCRIPTION_ENGINE.md",
      "anchor": ""
    },
    {
      "id": "tooling",
      "when": "Public tooling and the actual execution owner of each check",
      "paths": [
        "scripts/**"
      ],
      "doc": "CONTRIBUTING.md",
      "anchor": "#development-preview-checks"
    },
    {
      "id": "docs-impact",
      "when": "Documentation change impact and same-owner review enforcement",
      "paths": [
        "scripts/documentation-impact*.ts",
        "scripts/documentation-git*.ts"
      ],
      "doc": "docs/platform/DOCUMENTATION.md",
      "anchor": "#impact"
    },
    {
      "id": "docs-export",
      "when": "Generated documentation navigation and the checked bundle consumer boundary",
      "paths": [
        "scripts/documentation-bundle*.ts",
        "scripts/documentation-navigation*.ts",
        ".gitignore"
      ],
      "doc": "docs/platform/DOCUMENTATION.md",
      "anchor": "#exporting"
    },
    {
      "id": "tests",
      "when": "Integration and browser test sources; execution requires their declared owner",
      "paths": [
        "tests/**",
        "src/test/**"
      ],
      "doc": "CONTRIBUTING.md",
      "anchor": "#development-preview-checks"
    },
    {
      "id": "assets",
      "when": "Static public assets and their reference build consumption",
      "paths": [
        "public/**"
      ],
      "doc": "docs/platform/RUNTIME_AND_SELF_HOSTING.md",
      "anchor": "#runtime-model"
    },
    {
      "id": "operations",
      "when": "Deployment recipes and operational interface boundaries",
      "paths": [
        "deploy/**",
        "mcp/**"
      ],
      "doc": "docs/platform/RUNTIME_AND_SELF_HOSTING.md",
      "anchor": "#self-host-boundary"
    },
    {
      "id": "domain-accounting",
      "when": "Invoice contracts, canonical document amounts, jobs and delivery outcomes",
      "paths": [
        "src/domains/accounting/**",
        "server/domains/accounting/**"
      ],
      "doc": "src/domains/accounting/README.md",
      "anchor": ""
    },
    {
      "id": "domain-address-canon",
      "when": "Canonical addresses and pure address normalization",
      "paths": [
        "src/domains/address-canon/**",
        "server/domains/address-canon/**"
      ],
      "doc": "src/domains/address-canon/README.md",
      "anchor": ""
    },
    {
      "id": "domain-auth",
      "when": "Authentication, sessions, actor contracts and permission policy",
      "paths": [
        "src/domains/auth/**",
        "server/domains/auth/**"
      ],
      "doc": "src/domains/auth/README.md",
      "anchor": ""
    },
    {
      "id": "domain-bundle",
      "when": "Bundle composition contracts and item selection rules",
      "paths": [
        "src/domains/bundle/**",
        "server/domains/bundle/**"
      ],
      "doc": "src/domains/bundle/README.md",
      "anchor": ""
    },
    {
      "id": "domain-catalog",
      "when": "Canonical product catalogue contracts and storefront projections",
      "paths": [
        "src/domains/catalog/**",
        "server/domains/catalog/**"
      ],
      "doc": "src/domains/catalog/README.md",
      "anchor": ""
    },
    {
      "id": "domain-channels",
      "when": "Sales channel contracts, policy and channel operations",
      "paths": [
        "src/domains/channels/**",
        "server/domains/channels/**"
      ],
      "doc": "src/domains/channels/README.md",
      "anchor": ""
    },
    {
      "id": "domain-checkout",
      "when": "Checkout contracts, admission and purchase orchestration",
      "paths": [
        "src/domains/checkout/**"
      ],
      "doc": "src/domains/checkout/README.md",
      "anchor": ""
    },
    {
      "id": "domain-clients",
      "when": "Client identity and shared client contracts",
      "paths": [
        "src/domains/clients/**",
        "server/domains/clients/**"
      ],
      "doc": "src/domains/clients/README.md",
      "anchor": ""
    },
    {
      "id": "domain-commerce",
      "when": "Orders, commerce contracts and order management use cases",
      "paths": [
        "src/domains/commerce/**",
        "server/domains/commerce/**"
      ],
      "doc": "src/domains/commerce/README.md",
      "anchor": ""
    },
    {
      "id": "domain-communications",
      "when": "Message contracts, outbox orchestration and delivery ports",
      "paths": [
        "src/domains/communications/**",
        "server/domains/communications/**"
      ],
      "doc": "src/domains/communications/README.md",
      "anchor": ""
    },
    {
      "id": "domain-company-identity",
      "when": "Company identity and seller-facing shared contracts",
      "paths": [
        "src/domains/company-identity/**",
        "server/domains/company-identity/**"
      ],
      "doc": "src/domains/company-identity/README.md",
      "anchor": ""
    },
    {
      "id": "domain-customers",
      "when": "Customer contracts, account data and customer use cases",
      "paths": [
        "src/domains/customers/**",
        "server/domains/customers/**"
      ],
      "doc": "src/domains/customers/README.md",
      "anchor": ""
    },
    {
      "id": "domain-fulfillment",
      "when": "Physical fulfillment, shipment contracts and delivery evidence",
      "paths": [
        "src/domains/fulfillment/**",
        "server/domains/fulfillment/**"
      ],
      "doc": "src/domains/fulfillment/README.md",
      "anchor": ""
    },
    {
      "id": "domain-inventory",
      "when": "Inventory contracts, stock policy and durable inventory operations",
      "paths": [
        "src/domains/inventory/**",
        "server/domains/inventory/**"
      ],
      "doc": "src/domains/inventory/README.md",
      "anchor": ""
    },
    {
      "id": "domain-marketing",
      "when": "Marketing, prelaunch and research contracts and use cases",
      "paths": [
        "src/domains/marketing/**",
        "server/domains/marketing/**"
      ],
      "doc": "src/domains/marketing/README.md",
      "anchor": ""
    },
    {
      "id": "domain-observability",
      "when": "Operational events and retained diagnostic contracts",
      "paths": [
        "src/domains/observability/**",
        "server/domains/observability/**"
      ],
      "doc": "src/domains/observability/README.md",
      "anchor": ""
    },
    {
      "id": "domain-partners",
      "when": "Partner contracts and partner-facing domain rules",
      "paths": [
        "src/domains/partners/**",
        "server/domains/partners/**"
      ],
      "doc": "src/domains/partners/README.md",
      "anchor": ""
    },
    {
      "id": "domain-payment",
      "when": "Payment status vocabulary, provider-neutral ports and money-path rules",
      "paths": [
        "src/domains/payment/**",
        "server/domains/payment/**"
      ],
      "doc": "src/domains/payment/README.md",
      "anchor": ""
    },
    {
      "id": "domain-platform",
      "when": "Platform control, capabilities and operational contracts",
      "paths": [
        "src/domains/platform/**",
        "server/domains/platform/**"
      ],
      "doc": "src/domains/platform/README.md",
      "anchor": ""
    },
    {
      "id": "domain-platform-runtime",
      "when": "Shared runtime contracts and runtime configuration seams",
      "paths": [
        "src/domains/platform-runtime/**",
        "server/domains/platform-runtime/**"
      ],
      "doc": "src/domains/platform-runtime/README.md",
      "anchor": ""
    },
    {
      "id": "domain-pricing",
      "when": "Pricing contracts, calculations and price policy",
      "paths": [
        "src/domains/pricing/**"
      ],
      "doc": "src/domains/pricing/README.md",
      "anchor": ""
    },
    {
      "id": "domain-promo",
      "when": "Promotion contracts and promotion eligibility rules",
      "paths": [
        "src/domains/promo/**"
      ],
      "doc": "src/domains/promo/README.md",
      "anchor": ""
    },
    {
      "id": "domain-risk",
      "when": "Risk contracts and admission policy",
      "paths": [
        "src/domains/risk/**",
        "server/domains/risk/**"
      ],
      "doc": "src/domains/risk/README.md",
      "anchor": ""
    },
    {
      "id": "domain-shipping",
      "when": "Shipping contracts, quotes and carrier-neutral rules",
      "paths": [
        "src/domains/shipping/**",
        "server/domains/shipping/**"
      ],
      "doc": "src/domains/shipping/README.md",
      "anchor": ""
    },
    {
      "id": "domain-subscription",
      "when": "Subscription contracts, self-service policy and server orchestration",
      "paths": [
        "src/domains/subscription/**",
        "server/domains/subscription/**"
      ],
      "doc": "src/domains/subscription/README.md",
      "anchor": ""
    },
    {
      "id": "domain-support",
      "when": "Support contracts and operator-facing use cases",
      "paths": [
        "src/domains/support/**",
        "server/domains/support/**"
      ],
      "doc": "src/domains/support/README.md",
      "anchor": ""
    },
    {
      "id": "subscription-renewal",
      "when": "Read the actual renewal invocation, preflight, attempt and charge path",
      "paths": [
        "server/bff/subscriptions/renewal-ticks.ts",
        "server/domains/subscription/subscriptionRenewalInvocation.ts",
        "server/domains/subscription/chargeSubscriptionCycleOffSession.ts"
      ],
      "doc": "docs/platform/SUBSCRIPTION_WORKFLOWS.md",
      "anchor": "#renew-one-cycle"
    },
    {
      "id": "subscription-recovery",
      "when": "Session, token ownership, expiry, revocation and replay in payment recovery",
      "paths": [
        "server/domains/subscription/paymentRecoveryHandler.ts",
        "server/domains/subscription/paymentRecoveryPorts.ts"
      ],
      "doc": "docs/platform/SUBSCRIPTION_WORKFLOWS.md",
      "anchor": "#recover-payment"
    },
    {
      "id": "subscription-delivery",
      "when": "Renewal delivery admission and the durable replacement-confirmation boundary",
      "paths": [
        "server/domains/subscription/callSubscriptionDeliveryAlignmentAdmission.ts",
        "server/adapters/subscriptionDeliveryAlignmentGateway.ts"
      ],
      "doc": "docs/platform/SUBSCRIPTION_WORKFLOWS.md",
      "anchor": "#protect-delivery"
